rules_version = '2';

// Rules for the weekly shop's own Firebase project. The Deploy database rules
// workflow publishes this file whenever it changes on main.
//
// Everything for a household lives under households/{hid}. Only members can
// read or write it. Someone joins by opening an invite link, which writes
// their uid into members along with the household's current invite code.
// The order worker uses the Admin SDK, which these rules don't apply to.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).members; }

    match /shopUsers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 10;
      // Members change anything but can't remove the last member.
      allow update: if isMember(hid) && request.resource.data.members.size() > 0;
      // Joining: add only yourself, with the right code, and change nothing else.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode']);

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    // Invite lookups: code -> household id and display name. Can't be listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create, update: if isMember(request.resource.data.hid);
      allow delete: if signedIn() && isMember(resource.data.hid);
    }
  }
}
