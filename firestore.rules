rules_version = '2';

// Rules for the whole Firebase project music-app-d0f3f, which the music app and
// the weekly shop share. Firestore has one rule set per project, so this file
// holds both apps' rules: paste all of it into Firebase console › Firestore
// Database › Rules › Publish. (Publishing the music app's file on its own
// would lock the shop out, and the other way round.)
//
// Everything for a household lives under households/{hid}. Only members can
// read or write it. Someone joins by opening an invite link, which writes
// their uid into members along with the household's current invite code.
// The order worker uses the Admin SDK, which these rules don't apply to.
service cloud.firestore {
  match /databases/{database}/documents {

    // ======== Music app (copied from andrewwilson201/music-app/firestore.rules) ========
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function shareAt(token) { return /databases/$(database)/documents/shares/$(token); }

    // True when uid is sharing and the signed-in person added uid's current code.
    function canView(uid) {
      let token = get(/databases/$(database)/documents/users/$(uid)/meta/share).data.token;
      return signedIn()
        && get(shareAt(token)).data.uid == uid
        && exists(/databases/$(database)/documents/shares/$(token)/viewers/$(request.auth.uid));
    }

    // Owner: everything under their own user, read and write.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Friends: read only, and only the year pages.
    match /users/{uid}/years/{year} {
      allow read: if canView(uid);
    }

    // A share code, looked up by someone who was given it. Codes can't be listed.
    match /shares/{token} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      // People who added this code. Each adds only themselves; the owner can
      // see who they are and remove them.
      match /viewers/{viewer} {
        allow read: if signedIn()
          && (request.auth.uid == viewer || get(shareAt(token)).data.uid == request.auth.uid);
        allow create, update: if isOwner(viewer)
          && exists(shareAt(token))
          && request.resource.data.keys().hasOnly(['name', 'addedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80;
        allow delete: if signedIn()
          && (request.auth.uid == viewer || get(shareAt(token)).data.uid == request.auth.uid);
      }
    }

    // ======== Weekly shop ========

    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).members; }

    match /shopUsers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 10;
      // Members change anything but can't remove the last member.
      allow update: if isMember(hid) && request.resource.data.members.size() > 0;
      // Joining: add only yourself, with the right code, and change nothing else.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode']);

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    // Invite lookups: code -> household id and display name. Can't be listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create, update: if isMember(request.resource.data.hid);
      allow delete: if signedIn() && isMember(resource.data.hid);
    }
  }
}
